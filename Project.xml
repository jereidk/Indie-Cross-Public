<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="Indie Cross" file="Indie Cross" packageName="com.brightfyregit.indiecross" package="com.brightfyregit.indiecross" main="Main" version="1.5.0" company="Team 375" />
	
	<app preloader="flixel.system.FlxPreloader" />
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="1280" height="720" background="#000000" hardware="true" vsync="false" allow-shaders="true" require-shaders="true" />

	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" />
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" />

	<!--Requests SDL's real native framebuffer (SDL_WINDOW_ALLOW_HIGHDPI)
	    instead of a scaled-down logical one -- sharper rendering on the
	    high-density displays most Android phones have. Not gated on any
	    platform in Lime's own native window code, but excluded on mac to
	    match NightmareVision-Android-Support's own setting exactly.-->
	<window unless="mac" allow-high-dpi="true"/>

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bit" />

	<source path="source" />
	
	<library name="songs"    preload="true" />
	<library name="shared"   preload="true" />
	<library name="bendy"   preload="true" />
	<library name="sans"   preload="true" />
	<library name="cup"   preload="true" />
	<library name="achievements"   preload="true" />

	<assets path="assets/android" if="android"/> <!-- to not have the android assets in another builds -saw -->
	<assets path="assets/preload" rename="assets"/>
	<assets path="assets/songs"  library="songs"/>
	<assets path="assets/hiddenContent" embed="true" library="hiddenContent" unless="linux"/>
	<assets path="assets/hiddenContent" embed="false" library="hiddenContent" if="linux"/> <!-- linux hates embedding :/ -->
	<assets path="assets/shared"  library="shared"/>
	<assets path="assets/bendy"  library="bendy"/>
	<assets path="assets/sans"  library="sans"/>
	<assets path="assets/cup"  library="cup"/>
	<assets path="assets/achievements"  library="achievements"/>
	<assets path="assets/notes" embed="true" library="notes" unless="linux"/>
	<assets path="assets/notes" embed="false" library="notes" if="linux"/>
	<assets path="assets/videos"/>
	<assets path="assets/fonts" embed='true' unless="linux"/>
	<assets path="assets/fonts" embed='false' if="linux"/>

	<!--No project-level <ndll name="c++_shared"/> here on purpose -- hxvlc's
	    own include.xml (haxelib) already declares <ndll name="c++_shared"
	    dir="project/vlc/lib"/> for android unconditionally (VIDEOS_ALLOWED
	    is always on for android/cpp), and Lime's own project.ndlls list has
	    no name-based dedup: a second same-named entry here would ALSO copy
	    to the exact same jniLibs/<abi>/libc++_shared.so destination via
	    copyIfNewer, a silent, non-deterministic mtime race between the two
	    sources -- confirmed straight from Lime's own AndroidPlatform.hx.
	    Removed the redundant one instead of leaving that race in place.-->

	<!-- epic wacky shit -->
	<assets path="assets/compileData/plugins/plugins/" rename='plugins/' if="windows"/>
	<assets path="assets/compileData/plugins/plugins (but for mac)/" rename='plugins/' if="macos"/>
	<assets path="assets/compileData/dlls/" rename='' if="windows"/>
	<assets path="assets/compileData/IndieCross-Crash.exe" type="template" rename='FlixelCrashHandler.exe' if="windows" />
	<assets path='assets/compileData/crash logs go here.txt' rename='crash/crash logs go here.txt' />
	
	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />
	<haxelib name="flixel-ui" />
	<haxelib name="discord_rpc" if="desktop"/>
	<haxelib name="linc_luajit" if="cpp"/>
	<haxelib name="extension-androidtools" if="android"/>

	<!--Enables video playback via the hxvlc haxelib (replaces the old custom
	    source/vlc C++ extension, which never had Android binaries built for it).
	    Must be defined before the <haxelib name="hxvlc" .../> line below --
	    Lime evaluates a tag's if="..." condition against whatever's been
	    <define>d so far in file order, not the final define set, so a
	    VIDEOS_ALLOWED define placed after this haxelib entry (as this used to
	    be) is still undefined at the point the condition is checked and
	    silently drops hxvlc from the classpath even though -D VIDEOS_ALLOWED
	    shows up in the generated .hxml afterward.-->
	<define name="VIDEOS_ALLOWED" if="cpp"/>
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED"/>

	<!-- ______________________________ Haxedefines _____________________________ -->

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<!--Make's-the-game-use-less-ram-->
	<haxedef name="HXCPP_GC_BIG_BLOCKS" unless="debug" />

	<!--Makes crash messages show up (essential for SUtil's crash handler and
	    JavaCrashHandler to produce anything useful). Unconditional, not just
	    if="release" -- HXCPP_CHECK_POINTER's extra bounds/null checks turn a
	    raw native crash into a catchable Haxe exception with a real stack
	    trace, which matters just as much for a debug APK a tester runs
	    without a debugger attached as it does for release. Debug builds are
	    already far less optimized than release, so the relative performance
	    cost of adding this is much smaller there than it would be in
	    release. Matches NightmareVision-Android-Support's own CRASH_HANDLER,
	    which is unconditionally on for the same reason.-->
	<haxedef name="HXCPP_CHECK_POINTER" />
	<haxedef name="HXCPP_STACK_LINE" />
	<haxedef name="HXCPP_STACK_TRACE" />

	<!--Android-Internet-connection-stuff-->
	<android permission="android.permission.ACCESS_NETWORK_STATE"/>
	<android permission="android.permission.INTERNET"/>

	<!--SUtil.check()/AndroidUtils.requestAllFilesAccess() request these at
	    runtime, but Android silently refuses to grant (or even show an
	    enabled toggle for) any permission the app hasn't also declared here.
	    Without this, the "All files access" settings screen shows up but
	    its toggle stays permanently disabled, and every write to
	    SUtil.getPath()'s folder keeps silently failing regardless of what
	    the player taps. NightmareVision-Android-Support declares the same
	    three for the same reason.-->
	<android permission="android.permission.WRITE_EXTERNAL_STORAGE"/>
	<android permission="android.permission.READ_EXTERNAL_STORAGE"/>
	<android permission="android.permission.MANAGE_EXTERNAL_STORAGE"/>

	<!--Rest of NightmareVision-Android-Support's own permission set, adopted
	    in full for parity. MANAGE_MEDIA/READ_MEDIA_*: broader media access
	    on API 33+ than READ/WRITE_EXTERNAL_STORAGE alone cover.
	    ACCESS_WIFI_STATE: paired with ACCESS_NETWORK_STATE below.
	    CAPTURE_AUDIO_OUTPUT: system audio capture.-->
	<android permission="android.permission.MANAGE_MEDIA"/>
	<android permission="android.permission.READ_MEDIA_IMAGES"/>
	<android permission="android.permission.READ_MEDIA_AUDIO"/>
	<android permission="android.permission.READ_MEDIA_VIDEO"/>
	<android permission="android.permission.READ_MEDIA_DOCUMENTS"/>
	<android permission="android.permission.ACCESS_WIFI_STATE"/>
	<android permission="android.permission.CAPTURE_AUDIO_OUTPUT"/>

	<!-- Required for KizzyHelper's MediaSession notification (API 33+) --
	     without this, requestPermissions() for it is auto-denied since
	     Android refuses to grant any runtime permission that isn't also
	     declared here, and the notification silently never posts. -->
	<android permission="android.permission.POST_NOTIFICATIONS"/>

	<!--Java-side native crash capture/symbolication (Logger/GameLogger's
	    counterpart on the Java side) -- see mobile.backend.java.JavaCrashHandler-->
	<java path="source" if="android"/>
	<android extension="mobile.backend.java.JavaCrashHandler" />
	<android extension="mobile.backend.java.AndroidUtils" />
	<android extension="mobile.backend.java.ScreenUtil" />

	<!--Android Discord presence via Kizzy (see source/Discord.hx's #elseif
	    android branch / mobile.backend.AndroidRPC.hx / KizzyHelper.java's own
	    doc comment) -- ported from NightmareVision-Android-Support.-->
	<android extension="mobile.backend.java.KizzyHelper" />

	<!--ABI targeting: pass -D ANDROID_ARM64_ONLY or -D ANDROID_ARM32_ONLY
	    (both already passed by CI.yml's per-job Compile step) for a
	    single-ABI APK -- without either, both are built (fat APK). Verified
	    straight from Lime's own AndroidPlatform.hx: unlike the
	    ANDROID_ARM64_ONLY/ARM32_ONLY haxedefs (which only affect what
	    hxcpp itself compiles, not what ships), an architecture missing
	    from this list makes Lime delete that ABI's whole jniLibs/<abi>/
	    directory outright before Gradle ever runs -- a real, independent
	    restriction mechanism, not cosmetic. Matches NightmareVision-
	    Android-Support's own tags exactly. Left CI.yml's own
	    ndk.abiFilters Gradle patch in place alongside this rather than
	    removing it -- redundant now, but a wrong APK ABI is a silent
	    failure (not a compile error), so keeping both until a real build
	    confirms this alone is enough.-->
	<architecture name="arm64" unless="ANDROID_ARM32_ONLY" />
	<architecture name="armv7" unless="ANDROID_ARM64_ONLY" />

	<!--A stable signing identity across builds -- without one, Lime signs
	    each release with its own ad-hoc debug key, so a newer APK is never
	    recognized as an "update" to an older install and always needs a
	    full uninstall first. Self-signed, not a Play Store production key
	    (NightmareVision-Android-Support does the same: a throwaway
	    dev-signing keystore committed straight to the repo).-->
	<certificate path="key.keystore" password="indiecross" alias="indiecross" alias-password="indiecross" if="android"/>

	<!--Overrides specific files from Lime's own Android export template --
	    only files present under templates/android/template/ need exist;
	    everything else falls through to Lime's own default unchanged. See
	    templates/android/template/gradle.properties's own doc comment.-->
	<template path="templates/android" if="android"/>

	<!-- _________________________________ Custom _______________________________ -->

	<!--Place custom nodes like icons here (higher priority to override the HaxeFlixel icon)-->
	
	<icon path="assets/compileData/icon8.png" size='8'/>
	<icon path="assets/compileData/icon16.png" size='16'/>
	<icon path="assets/compileData/icon32.png" size='32'/>
	<icon path="assets/compileData/icon64.png" size='64'/>
	<icon path="assets/compileData/icon128.png" size='128'/>
	<icon path="assets/compileData/icon256.png" size='256'/>
	<icon path="assets/compileData/icon512.png" size='512'/>
	<icon path="assets/compileData/iconOG.png" />
	
</project>
